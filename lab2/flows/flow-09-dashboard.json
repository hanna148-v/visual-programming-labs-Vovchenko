        "id": "766a2ed92bab54c9",
        "type": "function",
        "z": "15359fe5383ead23",
        "name": "function 4",
        "func": "// Генерируем случайную температуру от 15 до 35 градусов\nconst temp = Math.floor(Math.random() * (35 - 15 + 1)) + 15;\n\n// Получаем порог из контекста (по умолчанию 25, если ещё не задан через форму)\nconst threshold = flow.get(\"tempThreshold\") || 25;\n\nmsg.payload = temp;\nmsg.topic = temp > threshold ? \"ALERT: Превышение!\" : \"Норма\";\n\nreturn msg;",
