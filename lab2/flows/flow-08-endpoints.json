    {
        "id": "ee0b47e439c1434e",
        "type": "function",
        "z": "4735bc331f959c61",
        "name": "function 3",
        "func": "// Получаем параметр id из query (?id=...)\nconst itemId = msg.req.query.id;\n\nif (!itemId) {\n    // Ошибка 400: параметр не передан\n    msg.statusCode = 400;\n    msg.payload = { error: \"Bad Request: параметр 'id' обязателен\" };\n} else if (itemId === \"404\") {\n    // Имитация ошибки 404: элемент не найден\n    msg.statusCode = 404;\n    msg.payload = { error: \"Not Found: элемент с таким id не найден\" };\n} else {\n    // Успешный ответ 200\n    msg.statusCode = 200;\n    msg.payload = {\n        id: itemId,\n        title: \"Товар #\" + itemId,\n        status: \"Available\"\n    };\n}\nreturn msg;",
