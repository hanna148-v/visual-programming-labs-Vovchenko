    {
        "id": "3958629c97a7a29c",
        "type": "function",
        "z": "5b16b1eea3f7906e",
        "name": "function 6",
        "func": "const text = msg.payload.content;\nconst chatId = msg.payload.chatId;\n\n// Режим хранится отдельно для каждого чата\nlet mode = context.get(\"mode_\" + chatId) || \"cat\";\n\nif (text === \"/start\") {\n    mode = \"cat\";\n    msg.payload.content = \"кошки кошки кошки(/dog)\";\n}\nelse if (text === \"/dog\") {\n    mode = \"dog\";\n    msg.payload.content = \"собачки собачки собачки(/start)\";\n}\n\nelse {\n    if (mode === \"cat\") {\n        msg.payload.content = \"кошки говорят: \" + text;\n    } else {\n        msg.payload.content = \"собачки говорят: \" + text;\n    }\n}\n\ncontext.set(\"mode_\" + chatId, mode);\n\nmsg.payload.chatId = chatId;\nmsg.payload.type = \"message\";\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
